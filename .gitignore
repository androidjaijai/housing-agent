# Plaintext source and decrypted output never go to GitHub; only the files in encrypted/ do.
/src/
/app-src/
/site/
/notes/
# Private keys must never be committed.
*private-key*
*.key
age-key*.txt
# Only the PUBLIC key belongs in keys/; anything else there (e.g. a private key generated by mistake) is ignored.
/keys/*
!/keys/recipient.txt
.DS_Store
/deploy/opalstack/*.env
