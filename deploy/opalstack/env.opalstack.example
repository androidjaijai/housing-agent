# Production environment for the HK rental agent site on Opalstack shared hosting.
# Uploaded ONCE by `opalstack-deploy.sh first-run` to $OPAL_APP_DIR/shared/.env (chmod 600) if that file is missing; never overwritten.
# Then edit it on the server (nano/vi) and fill in the blanks. Never commit the real file. Generate APP_KEY with: php artisan key:generate --show

APP_NAME="HK Rentals"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.example.com
APP_TIMEZONE=UTC
APP_LOCALE=zh_HK
APP_FALLBACK_LOCALE=zh_HK
APP_MAINTENANCE_DRIVER=file

# --- HTTPS / proxies / security headers ---
# Leave EMPTY first. Opalstack puts its own nginx in front of the app; only set this if, after deploying,
# request()->isSecure() is false behind it (symptoms: http:// asset URLs, redirect loops). Then set it to the
# front proxy's IP/CIDR (ask Opalstack support). Do NOT use "*": any client could forge X-Forwarded-* headers.
TRUSTED_PROXIES=
# Only the APP_URL host is accepted in the Host header (400 otherwise). Must be true in production. Optional extras:
SECURITY_TRUST_HOSTS=true
# SECURITY_TRUST_SUBDOMAINS=false
# SECURITY_TRUSTED_HOSTS=
# Opalstack serves HTTPS (enable it on the site in the dashboard).
FORCE_HTTPS=true
# Start with true for the first week, watch the browser console / report endpoint, then set false to enforce.
SECURITY_CSP_REPORT_ONLY=true
SECURITY_CSP_REPORT_URI=
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false
# SECURITY_CSP_EXTRA_SCRIPT_SRC=
# SECURITY_CSP_EXTRA_FRAME_SRC=

# --- Database: MariaDB on Opalstack. Create the DB + user in the dashboard (Databases) and copy the exact names. ---
# DB_CONNECTION=mysql also works; mariadb is the matching Laravel driver.
DB_CONNECTION=mariadb
# Verify the host in the Opalstack dashboard (usually localhost).
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Sessions, cache, queue: all database-backed (no Redis / supervisor on shared hosting). ---
# The queue is drained by a per-minute cron job (see crontab.opalstack.txt).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=
# REDIS_PORT=6379

# --- Logging: daily files, 14-day retention ---
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# --- Mail --- (check the Mail section of the Opalstack dashboard for the SMTP host, port and mailbox credentials)
MAIL_MAILER=smtp
MAIL_HOST=mail.opalstack.example
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# REQUIRED (must be a valid email): receives backup failure / unhealthy-backup notices.
# If empty, `composer install` fails in package:discover and the deploy aborts.
MAIL_ADMIN_ADDRESS=

# --- Files ---
FILESYSTEM_DISK=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-east-1
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# --- AI translation (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Spam protection (Cloudflare Turnstile). Leave empty to disable. GA4 id is set in admin: Settings. ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SPAM_MIN_SECONDS=3

# --- Watermark font (absolute path to a TTF with CJK glyphs, e.g. Noto Sans CJK) ---
WATERMARK_FONT=

# --- Search: database (default) or meilisearch ---
SCOUT_DRIVER=database
# SCOUT_DRIVER=meilisearch
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=

# --- Backups (spatie/laravel-backup; daily 01:30 HKT) ---
# backups = storage/app/backups on this server; s3 = the AWS_* bucket; "backups,s3" = both.
BACKUP_DISK=backups
BACKUP_NAME=housing-agent
# Optional AES password for the zip files (store it in your password manager: needed to restore).
BACKUP_ARCHIVE_PASSWORD=
BACKUP_MAX_STORAGE_MB=5000
BACKUP_NOTIFY_SUCCESS=false

# --- Health endpoint thresholds (/health) ---
HEALTH_REQUIRE_SCHEDULER=true
HEALTH_HEARTBEAT_MAX_AGE=300
HEALTH_MAX_QUEUE_SIZE=500
HEALTH_MIN_DISK_FREE_PERCENT=5
