# Copy to deploy/opalstack/opalstack.env (git-ignored) and fill in.
# Or keep it elsewhere and point at it: OPAL_CONFIG=/path/to/opalstack.env deploy/opalstack/opalstack-deploy.sh ...
# This file is sourced by bash: no spaces around "=", quote values containing spaces.

# SSH login for the Opalstack server (user@host). Use the literal word "local" to simulate on this machine.
OPAL_SSH=myuser@opal5.opalstack.com

# Optional extra ssh options (e.g. a dedicated key). Split on spaces.
# OPAL_SSH_OPTS="-i /home/me/.ssh/opalstack_ed25519 -o ServerAliveInterval=30"

# Absolute path of the app on the server. Releases, shared/ and current/ live below it.
OPAL_APP_DIR=/home/myuser/apps/housing_agent

# PHP CLI binary ON THE SERVER. Opalstack's CLI path differs from the one the web app uses;
# find it with:  ssh myuser@host 'ls /usr/local/bin/php* /usr/bin/php*'  and check "--version" is >= 8.3.
OPAL_PHP=/usr/local/bin/php83

# Composer ON THE SERVER (often ~/bin/composer after installing it there; absolute path recommended).
OPAL_COMPOSER=/home/myuser/bin/composer

# Public site URL (no trailing slash); used for the /health check in "status".
OPAL_URL=https://www.example.com

# LOCAL path of the age PRIVATE key. Keep it OUTSIDE this repository, chmod 600.
# It never leaves your machine: the app is decrypted here and rsynced to the server.
AGE_KEY_FILE=/home/me/.config/housing-agent/age-private-key.txt

# Branch of the encrypted repo to deploy (checked out and fast-forwarded before decrypting).
DEPLOY_BRANCH=claude/interactive-demo

# How many releases to keep on the server (the current and previous one are never pruned).
KEEP_RELEASES=5
